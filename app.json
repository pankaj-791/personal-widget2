{
  "expo": {
    "name": "Personal Widget",
    "slug": "personal-widget",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.personalwidget.app"
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PwQuickLaunch",
              "label": "Quick Launch",
              "description": "Open your favorite apps with one tap",
              "minWidth": "250dp",
              "minHeight": "70dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PwPersonalCard",
              "label": "Personal Card",
              "description": "Your name and four app shortcuts",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
